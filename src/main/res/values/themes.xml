<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Head" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_2_darken</item>
        <item name="colorPrimaryVariant">@color/primary_1</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/primary_2</item>
        <item name="colorOnSecondary">@color/dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/dark</item>
        <!-- Customize your theme here. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!--        <item name="android:textColor">@color/white</item>-->
    </style>

    <style name="Theme.Head.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Head.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Head.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Theme.Dxl" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/black</item>
        <item name="colorSecondaryVariant">@color/black</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/black</item>
        <!-- Customize your theme here. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!--        <item name="android:textColor">@color/white</item>-->
    </style>

    <style name="SwitchCompatTheme">
        <item name="thumbTint">@color/switch_color_thumb</item>
        <item name="trackTint">@color/switch_color_track</item>
    </style>

    <style name="DialogCallIn" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:layout_width">363dp</item>
        <item name="android:background">@drawable/btn_shape_rounded</item>
        <item name="android:backgroundTint">@color/gray_100</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="DialogCallIn__button">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/white_alt</item>
        <item name="android:lineSpacingExtra">-4sp</item>
        <item name="android:fontFamily">@font/raleway_700</item>
        <item name="android:textAlignment">center</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:layout_width">264dp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="DialogCallIn__title">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFamily">@font/raleway_800</item>
        <item name="android:lineHeight">38sp</item>
        <item name="android:lineSpacingExtra">1sp</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>

</resources>